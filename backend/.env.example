# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production-to-a-secure-random-64-char-string
SERVER_NAME=localhost:5000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/cef_portal
TEST_DATABASE_URL=postgresql://postgres:admin123@localhost:5432/cef_portal_test

# JWT Configuration
JWT_SECRET_KEY=change-this-jwt-secret-to-a-secure-random-64-char-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7
JWT_COOKIE_SECURE=False
JWT_COOKIE_CSRF_PROTECT=False
JWT_COOKIE_SAMESITE=Lax

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATELIMIT_DEFAULT=100/minute
RATELIMIT_STORAGE_URI=memory://
